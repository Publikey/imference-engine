{
  "id": "remove-background",
  "version": "1.0.0",
  "name": "Remove background",
  "category": "image",
  "mcp_name": "remove_background",
  "description": "Cut out the subject: transparent PNG, a mask, or the subject on a solid color.",
  "inputs": {
    "image": {
      "type": "image",
      "required": true,
      "max_megapixels": 16,
      "max_mb": 30,
      "description": "Source image"
    }
  },
  "params": {
    "model": {
      "type": "enum",
      "values": [
        "birefnet-lite",
        "isnet",
        "u2netp"
      ],
      "default": "birefnet-lite",
      "description": "birefnet-lite: best edges. isnet: general use. u2netp: tiny and fast (CPU)."
    },
    "output": {
      "type": "enum",
      "values": [
        "png-alpha",
        "mask",
        "color"
      ],
      "default": "png-alpha"
    },
    "background": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$",
      "default": "#ffffff",
      "description": "Background for output=color."
    },
    "threshold": {
      "type": "float",
      "min": 0,
      "max": 1,
      "description": "Hard cut at this level (default: soft alpha)."
    }
  },
  "outputs": {
    "image": {
      "type": "image",
      "format": "png"
    }
  },
  "weights": [
    {
      "name": "model",
      "path": "rembg/birefnet-general-lite.onnx",
      "size_mb": 224.0,
      "sha256": "5600024376f572a557870a5eb0afb1e5961636bef4e1e22132025467d0f03333",
      "source": "https://github.com/danielgatis/rembg/releases/download/v0.0.0/BiRefNet-general-bb_swin_v1_tiny-epoch_232.onnx",
      "when": {
        "model": "birefnet-lite"
      }
    },
    {
      "name": "model",
      "path": "rembg/isnet-general-use.onnx",
      "size_mb": 178.6,
      "sha256": "60920e99c45464f2ba57bee2ad08c919a52bbf852739e96947fbb4358c0d964a",
      "source": "https://github.com/danielgatis/rembg/releases/download/v0.0.0/isnet-general-use.onnx",
      "when": {
        "model": "isnet"
      }
    },
    {
      "name": "model",
      "path": "rembg/u2netp.onnx",
      "size_mb": 4.6,
      "sha256": "309c8469258dda742793dce0ebea8e6dd393174f89934733ecc8b14c76f4ddd8",
      "source": "https://github.com/danielgatis/rembg/releases/download/v0.0.0/u2netp.onnx",
      "when": {
