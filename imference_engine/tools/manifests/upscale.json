{
  "id": "upscale",
  "version": "1.1.0",
  "name": "Upscale",
  "category": "image",
  "mcp_name": "upscale",
  "description": "Upscale 2x or 4x with Real-ESRGAN (sharp details, no hallucinated content).",
  "inputs": {
    "image": {
      "type": "image",
      "required": true,
      "max_megapixels": 4,
      "max_mb": 30,
      "description": "Source image (at most 4 MP; the output is up to 64 MP)"
    }
  },
  "params": {
    "scale": {
      "type": "enum",
      "values": [
        2,
        4
      ],
      "default": 4
    },
    "model": {
      "type": "enum",
      "values": [
        "realesrgan-x4plus",
        "realesrgan-x4plus-anime"
      ],
      "default": "realesrgan-x4plus",
      "description": "x4plus for photos and renders, anime for illustrations."
    },
    "tile": {
      "type": "int",
      "min": 0,
      "max": 1024,
      "default": 256,
      "description": "Tile size (0 = whole image; lower uses less memory)."
    },
    "format": {
      "type": "enum",
      "values": [
        "webp",
        "png"
      ],
      "default": "webp",
      "description": "webp: high quality (lossy, q92), far smaller files. png: lossless. Over 16383 px a side the result is png."
    }
  },
  "outputs": {
    "image": {
      "type": "image"
    }
  },
  "weights": [
