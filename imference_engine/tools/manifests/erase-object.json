{
  "id": "erase-object",
  "version": "1.0.0",
  "name": "Magic eraser",
  "category": "image",
  "mcp_name": "erase_object",
  "description": "Remove what the mask covers and fill it with matching background (LaMa).",
  "inputs": {
    "image": {
      "type": "image",
      "required": true,
      "max_megapixels": 16,
      "max_mb": 30,
      "description": "Source image"
    },
    "mask": {
      "type": "mask",
      "required": true,
      "max_megapixels": 16,
      "max_mb": 30,
      "description": "White = area to erase, same size as the image"
    }
  },
  "params": {
    "dilate": {
      "type": "int",
      "min": 0,
      "max": 64,
      "default": 8,
      "description": "Grow the mask by this many pixels (catches edges and shadows)."
    }
  },
  "outputs": {
    "image": {
      "type": "image",
      "format": "png"
    }
  },
  "weights": [
    {
      "name": "model",
      "path": "lama/lama_fp32.onnx",
      "size_mb": 208.0,
      "sha256": "1faef5301d78db7dda502fe59966957ec4b79dd64e16f03ed96913c7a4eb68d6",
      "source": "https://huggingface.co/Carve/LaMa-ONNX/resolve/main/lama_fp32.onnx"
    }
  ],
  "runtimes": {
    "local": [
      "cpu",
      "cuda",
      "mps",
      "rocm",
      "directml"
    ],
    "cloud_queue": "tools-light",
    "min_ram_gb": 4
  },
  "cost": {
    "credits": 4
  },
  "license": {
